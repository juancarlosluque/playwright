{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": false,
        "removeComments": true,
        "noEmitOnError": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "typeRoots": [
            "./node_modules/@types",
            "src/helper/types"
        ],
        "types": ["node"],
        "paths": {
            "@pages/*": ["./src/pages/*"],
            "@helpers/*": ["./src/helper/*"],
            "@steps/*": ["./src/step-definitions/*"],
            "@hooks/*": ["./src/hooks/*"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test-results"
    ]
}