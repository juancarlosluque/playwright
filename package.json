{
  "name": "playwright-pacifico",
  "version": "1.0.0",
  "description": "Automated testing framework using Playwright and Cucumber for Pacífico project",
  "main": "index.js",
  "scripts": {
    "test:dev": "cross-env ENV=dev BROWSER=chrome cucumber-js --config=config/cucumber.js",
    "test:dev:slow": "cross-env ENV=dev BROWSER=chrome SLOW_MO=1200 cucumber-js --config=config/cucumber.js",
    "test:dev:demo": "cross-env ENV=dev BROWSER=chrome SLOW_MO=1500 STEP_SCREENSHOTS=true cucumber-js --config=config/cucumber.js",
    "test:uat": "cross-env ENV=uat BROWSER=chrome cucumber-js --config=config/cucumber.js",
    "test:dev:firefox": "cross-env ENV=dev BROWSER=firefox cucumber-js --config=config/cucumber.js",
    "test:dev:webkit": "cross-env ENV=dev BROWSER=webkit cucumber-js --config=config/cucumber.js",
    "test:headless": "cross-env ENV=dev BROWSER=chrome HEADLESS=true cucumber-js --config=config/cucumber.js",
    "test:parallel": "cross-env ENV=dev BROWSER=chrome cucumber-js --config=config/cucumber.js --parallel 2",
    "report": "npx ts-node src/helper/report.ts",
    "posttest:dev": "npm run report",
    "posttest:uat": "npm run report",
    "clean": "rimraf node_modules package-lock.json test-results",
    "clean:reports": "rimraf test-results/reports",
    "install:browsers": "npx playwright install",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["playwright", "cucumber", "automation", "testing", "e2e"],
  "author": "Pacífico Team",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.1",
    "@playwright/test": "^1.41.2",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "allure-commandline": "^2.27.0",
    "allure-cucumberjs": "^2.12.0",
    "allure-playwright": "^2.12.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^8.0.0",
    "multiple-cucumber-html-reporter": "^3.5.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
